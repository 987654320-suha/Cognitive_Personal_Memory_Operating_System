# CogniSphere v2.0 — Environment Variables Template
# Copy this file to .env for local development. Never commit real secrets to Git.

# ── Database ──────────────────────────────────────────────────────────────────
# Default: Local SQLite database
# Production (Render): PostgreSQL connection string (e.g. postgresql://user:pass@host/dbname)
DATABASE_URL=sqlite:///./reality_search.db

# ── CORS & Frontend Integration ───────────────────────────────────────────────
# Production frontend URL on Render (e.g. https://cognisphere-frontend.onrender.com)
FRONTEND_URL=http://localhost:3000

# Optional comma-separated additional allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ── LLM / Ollama Configuration ────────────────────────────────────────────────
# Local default: http://localhost:11434/api/generate
# Production: Remote Ollama URL / tunnel / self-hosted endpoint
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ── Embedding Model ───────────────────────────────────────────────────────────
# Model downloaded from HuggingFace on startup (default: all-mpnet-base-v2)
EMBEDDING_MODEL=all-mpnet-base-v2

# ── Object Detection (YOLOv8) ─────────────────────────────────────────────────
YOLO_MODEL_PATH=uploads/yolov8n.pt

# ── File Upload Settings ──────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── App Environment ───────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
